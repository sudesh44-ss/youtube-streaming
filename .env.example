# ==============================================================================
# OmniDiscover Environment Configuration
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Authenticated Encryption (AES-256-GCM)
# Required server-only 32+ character key for encrypting stored provider API keys
# ------------------------------------------------------------------------------
ENCRYPTION_SECRET=your_32_plus_character_secure_encryption_secret_here

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & PostgreSQL Database
# Retrieve these from your Supabase Project Settings -> API & Database
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-server-only-service-role-key

# ------------------------------------------------------------------------------
# 3. Distributed Redis Rate Limiting (Upstash Redis)
# Retrieve from Upstash Console -> Redis Database Details -> REST API
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ------------------------------------------------------------------------------
# 4. Local Development & Testing Credentials (Preserved Test Fixtures)
# Strictly active only when NODE_ENV !== 'production'
# ------------------------------------------------------------------------------
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=your_local_testing_password_here

# ------------------------------------------------------------------------------
# 5. External Provider Defaults (Optional: Users can connect keys via BYOK)
# ------------------------------------------------------------------------------
# YOUTUBE_API_KEY=AIzaSy...
# TMDB_API_KEY=...
